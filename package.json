{
  "name": "local-tex-editor",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "A local browser editor for TeX Live projects",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:windows-resources": "node scripts/build-windows-resources.mjs",
    "test": "playwright test --config tests/playwright.config.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:ui": "playwright test --config tests/playwright.config.mjs"
  },
  "dependencies": {
    "codemirror": "6.0.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/legacy-modes": "6.5.5",
    "@lezer/highlight": "1.2.5",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
